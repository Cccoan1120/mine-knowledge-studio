DATABASE_URL=postgresql://user:password@host.neon.tech/mine?sslmode=require
AUTH_SECRET=change-this-to-a-long-random-secret
HOST=127.0.0.1
MINE_IMPORT_PORT=8787

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra

# Embedding key/base URL default to AI_API_KEY/AI_BASE_URL when left empty.
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-3-small
# The database vector column requires exactly 1536 dimensions.
AI_EMBEDDING_DIMENSIONS=1536

AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o-mini

AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
AI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

MINE_YTDLP_COOKIES=
MINE_YTDLP_BROWSER=
MINE_YTDLP_TIMEOUT_MS=15000
