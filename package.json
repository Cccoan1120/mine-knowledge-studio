{
  "name": "mine-knowledge-studio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n import,web -c green,cyan \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:vite": "vite",
    "dev:import": "node server/index.js",
    "start": "node server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.2.0",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "prisma": "^7.8.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
